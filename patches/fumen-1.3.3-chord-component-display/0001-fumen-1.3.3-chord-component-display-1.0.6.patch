+
+for (const dc of [false, true]) test(`N05: ${dc ? 'D.C.' : 'D.S.'} al Coda is consumed at its destination`, () => {
+    expectNumbers(score({ segno: null }, { to: '1' }, { ds: null, dc, al: '1' },
