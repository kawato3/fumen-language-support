diff --git a/test/bar-numbering.test.mjs b/test/bar-numbering.test.mjs
new file mode 100644
index 0000000..7c8d04b
--- /dev/null
+++ b/test/bar-numbering.test.mjs
@@ -0,0 +1,253 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { numberBars } from '../src/renderer/bar_numbering.mjs';
+
+// Minimal Fumen node protocol; parser integration is exercised against the real
+// bundled parser in the extension's browser suite, not imitated by this helper.
+const element = (type, fields = {}) => ({ getElementName: () => type, ...fields });
+function bar(options = {}) {
+    const nodes = [element(options.start ? 'LoopBeginMark' : 'MeasureBoundaryMark')];
+    if (options.ending) nodes.push(element('LoopIndicator', { indstr: options.ending }));
+    if (options.rest !== undefined) nodes.push(element('LongRest', { longrestlen: options.rest }));
+    for (const [key, type] of [['segno', 'Segno'], ['coda', 'Coda'], ['to', 'ToCoda']]) {
+        if (key in options) nodes.push(element(type, { number: options[key], opt: options.option ?? null }));
+    }
+    if ('ds' in options || options.dc) nodes.push(element(options.dc ? 'DaCapo' : 'DalSegno', {
+        number: options.ds ?? null, al: options.al === 'Fine' ? element('Fine')
+            : options.al !== undefined ? element('Coda', { number: options.al }) : null
+    }));
+    if (options.fine) nodes.push(element('Fine'));
+    nodes.push(element(options.end !== undefined ? 'LoopEndMark' : 'MeasureBoundaryMark',
+        { times: options.end === 'X' ? 2 : options.end, ntimes: options.end === 'X' }));
+    return { childNodes: nodes };
+}
+const score = (...options) => options.map(bar);
+function expectNumbers(input, expected, reason = null) {
+    const result = numberBars(input);
+    assert.deepEqual(result.numbers, expected);
+    assert.equal(result.stop?.reason ?? null, reason);
+    return result;
+}
+
+test('N01: straight bars, long rest and empty measures continue from one', () => {
+    expectNumbers(score({}, { rest: 4 }, {}, {}), [[1], [2], [6], [7]]);
+    expectNumbers([], []);
+});
+
+for (const [start, expected] of [
+    [0, [[0, 2], [1, 3], [4], [8]]],
+    [-10, [[-10, -8], [-9, -7], [-6], [-2]]],
+    [30, [[30, 32], [31, 33], [34], [38]]]
+]) test(`N11: start ${start} is applied once across repeats and long rests`, () => {
+    assert.deepEqual(numberBars(score({ start: true }, { end: 2 }, { rest: 4 }, {}), start),
+        { numbers: expected, stop: null });
+});
+test('N11: a return jump does not restart the counter at the custom starting value', () => {
+    assert.deepEqual(numberBars(score({}, { fine: true }, { dc: true, al: 'Fine' }), 0),
+        { numbers: [[0, 3], [1, 4], [2]], stop: null });
+});
+test('N11: invalid starting values fall back to one without numeric coercion', () => {
+    for (const start of [null, true, false, '0', [], {}, 0.5, NaN, Infinity, -Infinity,
+        Number.MAX_SAFE_INTEGER + 1, Number.MIN_SAFE_INTEGER - 1]) {
+        assert.deepEqual(numberBars(score({}, {}), start), { numbers: [[1], [2]], stop: null }, String(start));
+    }
+});
+test('N11: both safe integer boundaries are supported and overflow still stops', () => {
