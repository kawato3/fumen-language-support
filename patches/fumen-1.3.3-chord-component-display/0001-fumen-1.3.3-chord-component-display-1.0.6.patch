+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const puppeteer = require("puppeteer");
+
+const distDirectory = path.resolve(__dirname, "..", "dist");
+
+function browserLaunchOptions() {
+    const bundledBrowser = puppeteer.executablePath();
+    const macOSArmChrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";
+    const executablePath = process.env.PUPPETEER_EXECUTABLE_PATH
+        || (process.platform === "darwin" && process.arch === "arm64" && fs.existsSync(macOSArmChrome)
+            ? macOSArmChrome
+            : bundledBrowser);
+    return { executablePath, headless: true };
+}
+
+// Renders the score and returns the texts drawn on canvas, in drawing order, with their x positions.
+async function drawnTexts(browser, code) {
+    const page = await browser.newPage();
+    try {
+        await page.addScriptTag({ path: path.join(distDirectory, "fumen.js") });
+        return await page.evaluate(async code => {
+            const calls = [];
+            const fillText = CanvasRenderingContext2D.prototype.fillText;
+            CanvasRenderingContext2D.prototype.fillText = function(text, x, y) {
+                if (this.canvas.dataset.score) calls.push({ text: String(text), x, y });
+                return fillText.apply(this, arguments);
+            };
+            const track = new Fumen.Parser().parse('%SHOW_FOOTER="NO"\n' + code);
+            if (!track) throw new Error("Invalid test score");
+            const renderer = new Fumen.DefaultRenderer(() => {
+                const canvas = document.createElement("canvas");
+                canvas.dataset.score = "true";
+                document.body.append(canvas);
+                return canvas;
+            });
+            await renderer.render(track);
+            return calls;
+        }, code);
+    } finally {
+        await page.close();
+    }
+}
+
+// Parses the score in a page and returns what each simile and rest holds as a lyric,
+// together with the code exported back from the parsed tree.
+async function parsedLyrics(browser, code) {
+    const page = await browser.newPage();
+    try {
+        await page.addScriptTag({ path: path.join(distDirectory, "fumen.js") });
+        return await page.evaluate(code => {
+            const track = new Fumen.Parser().parse(code);
+            const found = [];
+            (function walk(node) {
+                if (!node || typeof node !== "object") return;
+                if (node.constructor && (node.constructor.name === "Simile" || node.constructor.name === "Rest")) {
+                    found.push({ kind: node.constructor.name, lyric: node.lyric ? node.lyric.lyric : null,
+                        linked: node.lyric ? node.lyric.chorddep === node : null });
+                }
+                (node.childNodes || []).forEach(walk);
+            })(track);
+            return { found, exported: track.exportCode ? track.exportCode() : null };
+        }, code);
+    } finally {
+        await page.close();
+    }
+}
+
+// Returns whether each chord is accepted as a chord, and the texts drawn for the whole score.
+async function inspect(browser, chords) {
+    const page = await browser.newPage();
+    try {
+        await page.addScriptTag({ path: path.join(distDirectory, "fumen.js") });
+        return await page.evaluate(async chords => {
+            const accepted = {};
+            for (const chord of chords) {
+                const track = new Fumen.Parser(() => {}).parse("| " + chord + " |");
+                let valid = null;
+                (function walk(node, seen) {
+                    if (!node || typeof node !== "object" || seen.has(node)) return;
+                    seen.add(node);
+                    if (node.constructor && node.constructor.name === "Chord") valid = node.is_valid_chord;
+                    for (const key of Object.keys(node)) if (key !== "parent") walk(node[key], seen);
+                })(track, new Set());
+                accepted[chord] = valid;
+            }
+            const texts = [];
+            const fillText = CanvasRenderingContext2D.prototype.fillText;
+            CanvasRenderingContext2D.prototype.fillText = function(text) {
+                if (this.canvas.dataset.score) texts.push(String(text));
+                return fillText.apply(this, arguments);
+            };
+            const track = new Fumen.Parser().parse('%SHOW_FOOTER="NO"\n| ' + chords.join(" | ") + " |");
+            const renderer = new Fumen.DefaultRenderer(() => {
+                const canvas = document.createElement("canvas");
+                canvas.dataset.score = "true";
+                document.body.append(canvas);
+                return canvas;
+            });
+            await renderer.render(track);
+            return { accepted, texts };
+        }, chords);
+    } finally {
+        await page.close();
+    }
+}
+
+// Returns how many images (time signature digits, rests, marks) the score draws.
+async function drawnImages(browser, code) {
+    const page = await browser.newPage();
+    try {
+        await page.addScriptTag({ path: path.join(distDirectory, "fumen.js") });
+        return await page.evaluate(async code => {
+            let images = 0;
+            const drawImage = CanvasRenderingContext2D.prototype.drawImage;
+            CanvasRenderingContext2D.prototype.drawImage = function() {
+                if (this.canvas.dataset.score) images += 1;
+                return drawImage.apply(this, arguments);
+            };
+            const track = new Fumen.Parser().parse('%SHOW_FOOTER="NO"\n' + code);
+            if (!track) throw new Error("Invalid test score");
+            const renderer = new Fumen.DefaultRenderer(() => {
+                const canvas = document.createElement("canvas");
+                canvas.dataset.score = "true";
+                document.body.append(canvas);
+                return canvas;
+            });
+            await renderer.render(track);
+            return images;
+        }, code);
+    } finally {
+        await page.close();
+    }
+}
+
+(async () => {
+    const browser = await puppeteer.launch(browserLaunchOptions());
+    try {
+        // Parsing: a lyric before a simile or a rest is attached to it, the one before a chord is unchanged.
+        const parsed = await parsedLyrics(browser, "| `a`@ ./. | `b`@ r:1 | `c`@ C |");
+        assert.deepEqual(parsed.found, [
+            { kind: "Simile", lyric: "a", linked: true },
+            { kind: "Rest", lyric: "b", linked: true }
+        ]);
+        if (parsed.exported !== null) {
+            assert.match(parsed.exported, /`a`@ \.\/\./);
+            assert.match(parsed.exported, /`b`@ r:1/);
+        }
+
+        // A simile without lyric stays without one.
+        const plain = await parsedLyrics(browser, "| ./. |");
+        assert.deepEqual(plain.found, [{ kind: "Simile", lyric: null, linked: null }]);
+
+        // Drawing: the lyric text is drawn under a measure-wide simile and a whole rest.
+        const wide = (await drawnTexts(browser, "| C | `on simile`@ ./. | `on rest`@ r:1 |")).map(c => c.text);
+        assert.ok(wide.includes("on simile"), "lyric on a measure-wide simile is drawn");
+        assert.ok(wide.includes("on rest"), "lyric on a whole rest is drawn");
+
+        // Drawing: rows are split by "/" as for chords.
+        const rows = (await drawnTexts(browser, "| `first/second`@ ./. |")).map(c => c.text);
+        assert.ok(rows.includes("first") && rows.includes("second"));
+
+        // A chord later in the measure still takes the lyric, as in the published Fumen.
+        const lead = await parsedLyrics(browser, "| `x`@ r:4 C:2 D:4 | `y`@ ./. C |");
+        assert.deepEqual(lead.found, [
+            { kind: "Rest", lyric: null, linked: null },
+            { kind: "Simile", lyric: null, linked: null }
+        ]);
+        const before = (await drawnTexts(browser, "| `before`@ r:4 C:2 D:4 |")).map(c => c.text);
+        assert.ok(before.includes("before"), "the lyric is drawn under the chord");
+
+        // Drawing: with the 5 lines shown, a lyric on a whole rest and on a simile is drawn.
+        const staff = (await drawnTexts(browser, '%SHOW_STAFF="YES"\n| `solo`@ r:1 | `again`@ ./. |')).map(c => c.text);
+        assert.ok(staff.includes("solo") && staff.includes("again"));
+
+        // Drawing: the lyric is left-aligned with its element, and does not move the chord lyric.
+        const both = await drawnTexts(browser, "| `lc`@ C | `ls`@ ./. |");
+        const chordLyric = both.find(c => c.text === "lc");
+        const simileLyric = both.find(c => c.text === "ls");
+        assert.ok(chordLyric && simileLyric);
+        assert.ok(simileLyric.x > chordLyric.x, "second measure is to the right of the first");
+        assert.equal(simileLyric.y, chordLyric.y, "both lyrics are on the same row");
+
+        // Escapes in a lyric: \/ is a slash, \\ is a backslash, other backslashes are kept.
+        const escaped = (await drawnTexts(browser, "| `and\\/or`@ C | `a\\\\/b`@ D | `x\\y/z`@ E | `p/q`@ F | `s\\/t`@ ./. |")).map(c => c.text);
+        assert.ok(escaped.includes("and/or"), "\\/ is one slash in one row");
+        assert.ok(!escaped.includes("and") && !escaped.includes("or"), "\\/ does not split rows");
+        assert.ok(escaped.includes("a\\") && escaped.includes("b"), "\\\\ is a backslash, and a following / still splits");
+        assert.ok(escaped.includes("x\\y") && escaped.includes("z"), "a backslash before another character is kept");
+        assert.ok(escaped.includes("p") && escaped.includes("q"), "an unescaped slash still splits rows");
+        assert.ok(escaped.includes("s/t"), "escape works on a simile lyric");
+
+        // Escapes are kept in the exported code.
+        const roundTrip = await parsedLyrics(browser, "| `and\\/or`@ ./. |");
+        if (roundTrip.exported !== null) assert.match(roundTrip.exported, /`and\\\/or`@ \.\/\./);
+
+        // A lyric without "@" is still not attached to anything (upstream behaviour is unchanged).
+        const stray = await parsedLyrics(browser, "| `x` | ./. |");
+        assert.deepEqual(stray.found, [{ kind: "Simile", lyric: null, linked: null }]);
+
+        // Time signatures with more than one digit are drawn, one glyph per digit.
+        const single = await drawnImages(browser, "| (4/4) C |");
+        assert.equal(await drawnImages(browser, "| (12/8) C |"), single + 1, "12 has two digits");
+        assert.equal(await drawnImages(browser, "| (12/16) C |"), single + 2, "both numerals have two digits");
+        assert.equal(await drawnImages(browser, "| (3/16) C |"), single + 1);
+        assert.equal(await drawnImages(browser, "| (3/4) C | (12/8) D |"), single + single + 1);
+
+        // Added chord tensions.
+        const chords = ["Cadd4", "Cadd11", "Cadd13", "Cm7add11", "C7add13(b9)", "Cadd9", "Cadd2", "Cadd12", "Cadd1"];
+        const { accepted, texts } = await inspect(browser, chords);
+        for (const chord of ["Cadd4", "Cadd11", "Cadd13", "Cm7add11", "C7add13(b9)"]) {
+            assert.equal(accepted[chord], true, `${chord} is a chord`);
+        }
+        // Existing tensions are unchanged, and spellings that are not tensions are still not chords.
+        assert.equal(accepted.Cadd9, true);
+        assert.equal(accepted.Cadd2, true);
+        assert.equal(accepted.Cadd12, false);
+        assert.equal(accepted.Cadd1, false);
+        for (const text of ["add4", "add11", "add13"]) assert.ok(texts.includes(text), `${text} is drawn`);
+    } finally {
+        await browser.close();
+    }
+})().catch(error => { console.error(error); process.exitCode = 1; });
