+test('N03: repeat markers on only one side of a row boundary still work', () => {
+    const input = score({}, {}, {}, {});
+    input[0].childNodes[1] = element('LoopBeginMark');
+    input[3].childNodes[0] = element('LoopEndMark', { times: 2, ntimes: false });
+    expectNumbers(input, [[1], [2, 4], [3, 5], [6]]);
+});
+test('N09: large ending lists also consume the bounded control-work budget', () => {
+    const result = numberBars(score({ start: true }, { ending: Array(12000).fill('2').join(','), end: 2 }));
+    assert.equal(result.stop?.reason, 'visit-limit');
+    assert.deepEqual(result.numbers, [[1], []]);
+});
+
+for (const dc of [false, true]) test(`N05: ${dc ? 'D.C.' : 'D.S.'} al Coda is consumed at its destination`, () => {
+    expectNumbers(score({ segno: null }, { to: '1' }, { ds: null, dc, al: '1' },
+        { coda: '1' }, { to: '2' }, {}, { coda: '2' }, {}),
+        [[1, 4], [2, 5], [3], [6], [7], [8], [9], [10]]);
