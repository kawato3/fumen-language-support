diff --git a/test/bar-numbering.test.mjs b/test/bar-numbering.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7c8d04b0d76bb6b820f048ec11c6b8077a29e8eb
--- /dev/null
+++ b/test/bar-numbering.test.mjs
@@ -0,0 +1,253 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { numberBars } from '../src/renderer/bar_numbering.mjs';
+
+// Minimal Fumen node protocol; parser integration is exercised against the real
+// bundled parser in the extension's browser suite, not imitated by this helper.
+const element = (type, fields = {}) => ({ getElementName: () => type, ...fields });
+function bar(options = {}) {
+    const nodes = [element(options.start ? 'LoopBeginMark' : 'MeasureBoundaryMark')];
+    if (options.ending) nodes.push(element('LoopIndicator', { indstr: options.ending }));
+    if (options.rest !== undefined) nodes.push(element('LongRest', { longrestlen: options.rest }));
+    for (const [key, type] of [['segno', 'Segno'], ['coda', 'Coda'], ['to', 'ToCoda']]) {
+        if (key in options) nodes.push(element(type, { number: options[key], opt: options.option ?? null }));
+    }
+    if ('ds' in options || options.dc) nodes.push(element(options.dc ? 'DaCapo' : 'DalSegno', {
+        number: options.ds ?? null, al: options.al === 'Fine' ? element('Fine')
+            : options.al !== undefined ? element('Coda', { number: options.al }) : null
+    }));
+    if (options.fine) nodes.push(element('Fine'));
+    nodes.push(element(options.end !== undefined ? 'LoopEndMark' : 'MeasureBoundaryMark',
+        { times: options.end === 'X' ? 2 : options.end, ntimes: options.end === 'X' }));
+    return { childNodes: nodes };
+}
+const score = (...options) => options.map(bar);
+function expectNumbers(input, expected, reason = null) {
+    const result = numberBars(input);
+    assert.deepEqual(result.numbers, expected);
+    assert.equal(result.stop?.reason ?? null, reason);
+    return result;
+}
+
+test('N01: straight bars, long rest and empty measures continue from one', () => {
+    expectNumbers(score({}, { rest: 4 }, {}, {}), [[1], [2], [6], [7]]);
+    expectNumbers([], []);
+});
+
+for (const [start, expected] of [
+    [0, [[0, 2], [1, 3], [4], [8]]],
+    [-10, [[-10, -8], [-9, -7], [-6], [-2]]],
+    [30, [[30, 32], [31, 33], [34], [38]]]
+]) test(`N11: start ${start} is applied once across repeats and long rests`, () => {
+    assert.deepEqual(numberBars(score({ start: true }, { end: 2 }, { rest: 4 }, {}), start),
+        { numbers: expected, stop: null });
+});
+test('N11: a return jump does not restart the counter at the custom starting value', () => {
+    assert.deepEqual(numberBars(score({}, { fine: true }, { dc: true, al: 'Fine' }), 0),
+        { numbers: [[0, 3], [1, 4], [2]], stop: null });
+});
+test('N11: invalid starting values fall back to one without numeric coercion', () => {
+    for (const start of [null, true, false, '0', [], {}, 0.5, NaN, Infinity, -Infinity,
+        Number.MAX_SAFE_INTEGER + 1, Number.MIN_SAFE_INTEGER - 1]) {
+        assert.deepEqual(numberBars(score({}, {}), start), { numbers: [[1], [2]], stop: null }, String(start));
+    }
+});
+test('N11: both safe integer boundaries are supported and overflow still stops', () => {
+    assert.deepEqual(numberBars(score({}, {}), Number.MIN_SAFE_INTEGER),
+        { numbers: [[-9007199254740991], [-9007199254740990]], stop: null });
+    assert.deepEqual(numberBars(score({}, {}), Number.MAX_SAFE_INTEGER),
+        { numbers: [[9007199254740991], []], stop: { reason: 'counter-limit', measure: 1 } });
+});
+
+for (const [times, expected] of [
+    [1, [[1], [2], [3]]], [2, [[1, 3], [2, 4], [5]]],
+    [3, [[1, 3, 5], [2, 4, 6], [7]]]
+]) test(`N02: ${times} total repeat passes`, () => {
+    expectNumbers(score({ start: true }, { end: times }, {}), expected);
+});
+
+test('N03: initial repeat end without a start returns to the beginning', () => {
+    expectNumbers(score({}, { end: 2 }, {}), [[1, 3], [2, 4], [5]]);
+});
+test('N03: adjacent repeats and paired nested repeats have independent counters', () => {
+    expectNumbers(score({ start: true, end: 2 }, { start: true, end: 2 }, {}), [[1, 2], [3, 4], [5]]);
+    expectNumbers(score({ start: true }, { start: true, end: 2 }, { end: 2 }, {}),
+        [[1, 5], [2, 3, 6, 7], [4, 8], [9]]);
+});
+test('N03: shared boundary nodes are processed once on each side', () => {
+    const shared = element('LoopBothMark', { times: 2, ntimes: false });
+    const input = score({ start: true }, {}, {}, { end: 2 }, {});
+    input[1].childNodes[1] = shared;
+    input[2].childNodes[0] = shared;
+    expectNumbers(input, [[1, 3], [2, 4], [5, 7], [6, 8], [9]]);
+});
+
+test('N04: first and trailing second endings', () => {
+    expectNumbers(score({ start: true }, { ending: '1.', end: 2 }, { ending: '2.' }, {}),
+        [[1, 3], [2], [4], [5]]);
+});
+test('N04: numeric ranges and comma lists; skipped ending still repeats', () => {
+    expectNumbers(score({ start: true }, { ending: '1.' }, { ending: '2-3.', end: 3 }, {}),
+        [[1, 3, 5], [2], [4, 6], [7]]);
+    expectNumbers(score({ start: true }, { ending: '1,3.' }, { ending: '2.', end: 3 }, {}),
+        [[1, 3, 5], [2, 6], [4], [7]]);
+});
+test('N04: multi-measure endings skip all their bars', () => {
+    expectNumbers(score({ start: true }, { ending: '1.' }, { end: 2 }, { ending: '2.' }, {}),
+        [[1, 4], [2], [3], [5], [6]]);
+});
+
+test('N05: D.C. al Fine and standalone Fine', () => {
+    expectNumbers(score({}, { fine: true }, { dc: true, al: 'Fine' }, {}), [[1, 4], [2, 5], [3], []]);
+    expectNumbers(score({}, { fine: true }, {}), [[1], [2], []]);
+});
+test('N05: numbered D.S. al Fine and one-shot bare D.S.', () => {
+    expectNumbers(score({}, { segno: '2' }, { fine: true }, { ds: '2', al: 'Fine' }, {}),
+        [[1], [2, 5], [3, 6], [4], []]);
+    expectNumbers(score({ segno: null }, { ds: null }, {}), [[1, 3], [2, 4], [5]]);
+});
+for (const dc of [false, true]) test(`N05: ${dc ? 'D.C.' : 'D.S.'} al Coda honors its target`, () => {
+    expectNumbers(score({ segno: null }, { to: '2' }, { ds: null, dc, al: '2' },
+        {}, { coda: '2' }, {}), [[1, 4], [2, 5], [3], [], [6], [7]]);
+});
+test('N05: bare return enables To Coda; al Coda ignores an earlier Fine', () => {
+    expectNumbers(score({ segno: null }, { to: null }, { ds: null }, { coda: null }),
+        [[1, 4], [2, 5], [3], [6]]);
+    expectNumbers(score({ segno: null, fine: true }, { to: null }, { ds: null, al: null }, { coda: null }),
+        [[1, 4], [2, 5], [3], [6]]);
+});
+for (const option of [null, 'straight', 'with repeat']) test(`N06: return policy ${option}`, () => {
+    const repeated = option === 'with repeat';
+    expectNumbers(score({ start: true, segno: null, option }, { end: 2 }, { fine: true }, { ds: null, al: 'Fine' }),
+        repeated ? [[1, 3, 7, 9], [2, 4, 8, 10], [5, 11], [6]]
+            : [[1, 3, 7], [2, 4, 8], [5, 9], [6]]);
+});
+test('N06: a straight return selects the final ending', () => {
+    expectNumbers(score({ start: true }, { ending: '1.', end: 2 }, { ending: '2.', fine: true }, { dc: true, al: 'Fine' }),
+        [[1, 3, 6], [2], [4, 7], [5]]);
+});
+test('N07: xX keeps only the known prefix, including its first pass', () => {
+    expectNumbers(score({}, { start: true }, { end: 'X' }, {}), [[1], [2], [3], []], 'indefinite-repeat');
+});
+test('N07: an unreachable xX does not affect a finished route', () => {
+    expectNumbers(score({ fine: true }, { start: true, end: 'X' }), [[1], []]);
+});
+
+for (const value of [0, -1, 1.5, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+    test(`N08: invalid repeat count ${value}`, () => {
+        expectNumbers(score({ start: true }, { end: value }, {}), [[1], [2], []], 'invalid-repeat');
+    });
+    test(`N08: invalid rest length ${value}`, () => {
+        expectNumbers(score({}, { rest: value }, {}), [[1], [], []], 'invalid-rest');
+    });
+}
+for (const ending of ['Solo', '2-1.', '0.', '1 trailing text', '1,,2', '9007199254740992']) {
+    test(`N08: unsupported ending ${ending}`, () => {
+        expectNumbers(score({ start: true }, { ending, end: 2 }), [[1], []], 'unsupported-ending');
+    });
+}
+test('N08: endings without a repeat and absent final endings are not guessed', () => {
+    expectNumbers(score({}, { ending: '2.' }), [[1], []], 'unsupported-ending');
+    expectNumbers(score({ start: true }, { ending: '1.', end: 2 }, { ending: '3.' }),
+        [[1, 3], [2], []], 'unsupported-ending');
+});
+test('N08: missing and duplicate Segnos, missing Coda, absent requested Fine', () => {
+    expectNumbers(score({}, { ds: null }, {}), [[1], [2], []], 'invalid-navigation');
+    expectNumbers(score({ segno: null }, { segno: null }, { ds: null }), [[1], [2], [3]], 'invalid-navigation');
+    expectNumbers(score({ segno: null, to: null }, { ds: null, al: null }), [[1, 3], [2]], 'invalid-navigation');
+    expectNumbers(score({ dc: true, al: 'Fine' }), [[1, 2]], 'invalid-navigation');
+});
+test('N08: unmatched repeat and with-repeat jump into the middle are rejected', () => {
+    expectNumbers(score({}, { start: true }, {}), [[1], [], []], 'invalid-repeat');
+    expectNumbers(score({ start: true }, { segno: null, option: 'with repeat', end: 2 }, { ds: null }),
+        [[1, 3], [2, 4], [5]], 'invalid-navigation');
+});
+test('N09: huge range is evaluated without expanding it into an array', () => {
+    const result = numberBars(score({ start: true }, { ending: '1-9007199254740991', end: 9007199254740991 }));
+    assert.equal(result.stop.reason, 'visit-limit');
+    assert.ok(result.numbers.flat().length <= 10000);
+});
+test('N09: extreme repetition is bounded; counter overflow is not rounded', () => {
+    const result = numberBars(score({ start: true, end: Number.MAX_SAFE_INTEGER }));
+    assert.equal(result.stop.reason, 'visit-limit');
+    assert.equal(result.numbers[0].length, 10000);
+    expectNumbers(score({ rest: Number.MAX_SAFE_INTEGER }, {}), [[1], []], 'counter-limit');
+});
+test('N10: repeated analysis does not mutate nodes or retain state', () => {
+    const input = score({ start: true }, { end: 2 }, {});
+    const before = JSON.stringify(input);
+    assert.deepEqual(numberBars(input), numberBars(input));
+    assert.equal(JSON.stringify(input), before);
+});
+
+test('N03/N04: an ending at a new repeat start belongs to that new repeat', () => {
+    expectNumbers(score({ start: true, end: 2 }, { start: true, ending: '1.' },
+        { ending: '2.', end: 2 }, {}), [[1, 2], [3], [4], [5]]);
+});
+test('N08: with-repeat return inside an enclosing repeat is ambiguous', () => {
+    expectNumbers(score({ start: true }, { start: true, segno: null, option: 'with repeat', end: 2 },
+        { end: 2 }, { ds: null }), [[1, 5], [2, 3, 6, 7], [4, 8], [9]], 'invalid-navigation');
+});
+test('N08: duplicate Coda, conflicting jump instructions and unsafe counts stop locally', () => {
+    expectNumbers(score({ segno: null }, { to: null }, { ds: null }, { coda: null }, { coda: null }),
+        [[1, 4], [2, 5], [3], [], []], 'invalid-navigation');
+    const input = score({}, { ds: null });
+    input[1].childNodes.splice(1, 0, element('DaCapo', { al: null }));
+    expectNumbers(input, [[1], []], 'invalid-navigation');
+});
+test('N05: al Fine does not follow To Coda on the return', () => {
+    expectNumbers(score({ segno: null, to: null }, { fine: true }, { ds: null, al: 'Fine' }, { coda: null }),
+        [[1, 4], [2, 5], [3], []]);
