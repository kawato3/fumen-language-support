+++ b/src/renderer/bar_numbering.mjs
@@ -0,0 +1,214 @@
+// Pure performance-order numbering; kept separate from engraving and playback.
+// No source-node mutation, DOM, timers, persistent cache or expanded repeat tree.
+const MAX_STEPS = 10000;
+const kind = node => node?.getElementName();
+const positiveInteger = value => Number.isSafeInteger(value) && value > 0;
+const begins = node => ['LoopBeginMark', 'LoopBothMark'].includes(kind(node));
+const ends = node => ['LoopEndMark', 'LoopBothMark'].includes(kind(node));
+const key = node => node.number ?? '';
+
+function endingRanges(text) {
+    const ranges = [];
+    for (const part of text.split(',')) {
+        const match = /^\s*(\d+)\.?\s*(?:-\s*(\d+)\.?)?\s*$/.exec(part);
+        if (!match) return null;
+        const first = Number(match[1]), last = Number(match[2] ?? match[1]);
+        if (!positiveInteger(first) || !positiveInteger(last) || last < first) return null;
+        ranges.push([first, last]);
+    }
+    return ranges;
+}
+
+function prepare(measures) {
+    const bars = measures.map(measure => {
+        const nodes = measure.childNodes;
+        const byType = new Map();
+        let contentError = null, entryError = null;
+        for (const node of nodes) {
+            const type = kind(node);
+            if (!['LoopIndicator', 'LongRest', 'Segno', 'Coda', 'ToCoda', 'DalSegno', 'DaCapo', 'Fine'].includes(type)) continue;
+            if (byType.has(type)) {
+                if (type === 'LoopIndicator') entryError = 'unsupported-ending';
+                else contentError = 'invalid-navigation';
+            }
+            byType.set(type, node);
+        }
+        const jump = byType.get('DalSegno') ?? byType.get('DaCapo');
+        if ((byType.has('DalSegno') && byType.has('DaCapo')) ||
+            (jump && (byType.has('ToCoda') || byType.has('Fine')))) contentError = 'invalid-navigation';
+        return { first: nodes[0], last: nodes[nodes.length - 1], entryError, contentError, jump,
+            ending: byType.get('LoopIndicator'), rest: byType.get('LongRest'),
+            segno: byType.get('Segno'), coda: byType.get('Coda'),
+            toCoda: byType.get('ToCoda'), fine: byType.has('Fine'), loop: null };
+    });
+    const stack = [], loops = [], starts = new Map(), finishes = new Map();
+    const segnos = new Map(), codas = new Map();
+    function target(map, node, index) {
+        if (node) map.set(key(node), map.has(key(node)) ? null : index);
+    }
+    bars.forEach((bar, index) => {
+        // A boundary can be represented on either or both adjacent measures,
+        // especially across a source newline. Process each side exactly once.
+        if (begins(bar.first) || begins(bars[index - 1]?.last)) {
+            const loop = { start: index, outerStart: stack[0]?.start ?? index, end: null, children: [], endings: [] };
+            if (stack.length) stack[stack.length - 1].children.push(loop);
+            stack.push(loop);
+            loops.push(loop);
+            starts.set(index, loop);
+        }
+        bar.loop = stack[stack.length - 1] ?? null;
+        const end = ends(bar.last) ? bar.last : ends(bars[index + 1]?.first) ? bars[index + 1].first : null;
+        if (end) {
+            let loop = stack.pop();
+            if (!loop && loops.length === 0) {
+                loop = { start: 0, outerStart: 0, end: null, children: [], endings: [] };
+                loops.push(loop);
+                starts.set(0, loop);
+                for (let i = 0; i <= index; i++) bars[i].loop = loop;
+            }
+            if (!loop) bar.endError = true;
+            else {
+                Object.assign(loop, { end: index, times: end.times, indefinite: end.ntimes });
+                finishes.set(index, loop);
+            }
+        }
+        target(segnos, bar.segno, index);
+        target(codas, bar.coda, index);
+    });
+    for (const loop of stack) bars[loop.start].entryError = 'invalid-repeat';
+    bars.forEach((bar, index) => {
+        if (!bar.ending) return;
+        // A final alternative may immediately follow the repeat-end measure.
+        const loop = starts.get(index) ?? finishes.get(index - 1) ?? bar.loop;
+        const ranges = endingRanges(bar.ending.indstr);
+        if (!loop || !ranges) bar.entryError = 'unsupported-ending';
+        else {
+            bar.ending = { loop, ranges, next: null };
+            const previous = loop.endings[loop.endings.length - 1];
+            if (previous !== undefined) bars[previous].ending.next = index;
+            loop.endings.push(index);
+        }
+    });
+    return { bars, starts, finishes, segnos, codas, hasJumps: bars.some(bar => bar.jump) };
+}
+
+/** Return every known visit number per measure and an optional partial-result reason.
+ * The starting number may be any safe integer; invalid values use one.
+ */
+export function numberBars(measures, start = 1) {
+    const { bars, starts, finishes, segnos, codas, hasJumps } = prepare(measures);
+    const numbers = measures.map(() => []);
+    const passes = new Map(), takenJumps = new Set();
+    let position = 0, nextNumber = Number.isSafeInteger(start) ? start : 1;
+    let steps = 0, returnJourney = null, stop = null;
+    const halt = reason => { stop = { reason, measure: position }; };
+    const passOf = loop => returnJourney?.straight ? loop.times : (passes.get(loop) ?? 1);
+    function step() {
+        if (steps++ < MAX_STEPS) return true;
+        halt('visit-limit');
+        return false;
+    }
+
+    function resetChildren(loop) {
+        // Iterate lazily: both a wide subtree and a deep one must obey the same
+        // budget, without recursion or input-sized argument/temporary arrays.
+        const pending = [loop.children.values()];
+        while (pending.length) {
+            const next = pending[pending.length - 1].next();
+            if (next.done) { pending.pop(); continue; }
+            if (!step()) return false;
+            const child = next.value;
+            passes.delete(child);
+            if (child.children.length) pending.push(child.children.values());
+        }
+        return true;
+    }
+    function finishRepeat(loop) {
+        if (loop.indefinite) { halt('indefinite-repeat'); return; }
+        if (!positiveInteger(loop.times)) { halt('invalid-repeat'); return; }
+        const pass = passOf(loop);
+        if (pass < loop.times) {
+            passes.set(loop, pass + 1);
+            if (resetChildren(loop)) position = loop.start;
+        } else position = loop.end + 1;
+    }
+    function navigate(bar) {
+        if (bar.fine && ((!returnJourney && !hasJumps) ||
+            (returnJourney && (returnJourney.phase === 'coda' || returnJourney.al !== 'Coda')))) {
+            position = bars.length;
+            returnJourney = null;
+            return true;
+        }
+        if (bar.toCoda && returnJourney?.phase === 'return' && returnJourney.al !== 'Fine' &&
+            (returnJourney.al !== 'Coda' || returnJourney.coda === key(bar.toCoda))) {
+            const destination = codas.get(key(bar.toCoda));
+            if (!Number.isInteger(destination) || destination <= position) halt('invalid-navigation');
+            else {
+                position = destination;
+                // The requested transfer is consumed, not converted into a bare
+                // return that could authorize unrelated To Coda instructions.
+                returnJourney.phase = 'coda';
+                passes.clear();
+            }
+            return true;
+        }
+        if (bar.jump && !takenJumps.has(position)) {
+            const destination = kind(bar.jump) === 'DaCapo' ? 0 : segnos.get(key(bar.jump));
+            if (!Number.isInteger(destination) || destination > position) { halt('invalid-navigation'); return true; }
+            const target = bars[destination];
+            const withRepeat = kind(bar.jump) === 'DalSegno' && /^with\s+repeat$/.test(target.segno?.opt ?? '');
+            if (withRepeat && target.loop && target.loop.outerStart !== destination) { halt('invalid-navigation'); return true; }
+            takenJumps.add(position);
+            returnJourney = { straight: !withRepeat, al: kind(bar.jump.al) ?? null,
+                coda: bar.jump.al ? key(bar.jump.al) : null, phase: 'return' };
+            passes.clear();
+            position = destination;
+            return true;
+        }
+        return false;
+    }
+
+    while (position < bars.length && !stop) {
+        if (!step()) break;
+        const bar = bars[position];
+        // Validate the route selector before using it; validate measure content
+        // only after selection, because unplayed endings cannot affect the route.
+        if (bar.entryError) { halt(bar.entryError); break; }
+        const start = starts.get(position);
+        if (start && !passes.has(start)) passes.set(start, 1);
+        if (bar.ending) {
+            const { loop, ranges, next } = bar.ending;
+            const pass = passOf(loop);
+            let matches = false;
+            for (const [first, last] of ranges) {
+                if (!step()) break;
+                if (first <= pass && pass <= last) { matches = true; break; }
+            }
+            if (stop) break;
+            if (!matches) {
+                if (position > loop.end) halt('unsupported-ending');
+                else if (next !== null && next <= loop.end) position = next;
+                else finishRepeat(loop);
+                continue;
+            }
+        }
+        if (bar.contentError) { halt(bar.contentError); break; }
+        const span = bar.rest ? bar.rest.longrestlen : 1;
+        if (!positiveInteger(span)) { halt('invalid-rest'); break; }
+        if (!Number.isSafeInteger(nextNumber)) { halt('counter-limit'); break; }
+        numbers[position].push(nextNumber);
+        nextNumber += span;
+        if (bar.endError) { halt('invalid-repeat'); break; }
+        // Navigation and repeat-end on the same bar have ambiguous precedence.
+        const end = finishes.get(position);
+        if (end && (bar.jump || bar.toCoda || bar.fine)) { halt('invalid-navigation'); break; }
+        if (navigate(bar)) continue;
+        if (end) finishRepeat(end);
+        else position++;
+    }
+    if (!stop && returnJourney?.phase === 'return' &&
+        (returnJourney.al === 'Fine' || returnJourney.al === 'Coda')) {
+        stop = { reason: 'invalid-navigation', measure: bars.length - 1 };
+    }
+    return { numbers, stop };
+}
