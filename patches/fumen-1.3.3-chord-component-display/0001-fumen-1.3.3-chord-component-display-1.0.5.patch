+});
+test('N05: Fine may finish the coda after the requested transfer', () => {
+    expectNumbers(score({ segno: null }, { to: null }, { ds: null, al: null },
+        { coda: null }, { fine: true }, {}),
+        [[1, 4], [2, 5], [3], [6], [7], []]);
+});
+test('N04/N08: navigation errors matter only inside the selected ending', () => {
+    const input = score({ start: true }, { ending: '2.', dc: true }, { end: 1 }, {});
