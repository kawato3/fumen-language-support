diff --git a/test/chord-labels.test.js b/test/chord-labels.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..fa58477953f96a02f01764ade919d3d5054d6b33
--- /dev/null
+++ b/test/chord-labels.test.js
@@ -0,0 +1,150 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const puppeteer = require("puppeteer");
+
+const distDirectory = path.resolve(__dirname, "..", "dist");
+const baseFontSize = 28;
+const compactLabelWidth = baseFontSize * 0.5;
+
+function browserLaunchOptions() {
+    const bundledBrowser = puppeteer.executablePath();
+    const macOSArmChrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";
+    const executablePath = process.env.PUPPETEER_EXECUTABLE_PATH
+        || (process.platform === "darwin" && process.arch === "arm64" && fs.existsSync(macOSArmChrome)
+            ? macOSArmChrome
+            : bundledBrowser);
+
+    return {
+        executablePath,
+        headless: true
+    };
+}
+
+async function captureRender(browser, code) {
+    const page = await browser.newPage();
+    try {
+        await page.addScriptTag({ path: path.join(distDirectory, "fumen.js") });
+        return await page.evaluate(async code => {
+            const calls = [];
+            const images = [];
+            const fillText = CanvasRenderingContext2D.prototype.fillText;
+            CanvasRenderingContext2D.prototype.fillText = function(text, x, y, maxWidth) {
+                if (this.canvas.dataset.score) calls.push({ text: String(text), x, y, font: this.font,
+                    maxWidth: maxWidth === undefined ? null : maxWidth, naturalWidth: this.measureText(text).width });
+                return fillText.apply(this, arguments);
+            };
+            const drawImage = CanvasRenderingContext2D.prototype.drawImage;
+            CanvasRenderingContext2D.prototype.drawImage = function(image, x, y, width, height) {
+                if (this.canvas.dataset.score) images.push({ x, y, width, height });
+                return drawImage.apply(this, arguments);
+            };
+            const track = new Fumen.Parser().parse('%SHOW_FOOTER="NO"\n' + code);
+            if (!track) throw new Error("Invalid test score");
+            const renderer = new Fumen.DefaultRenderer(() => {
+                const canvas = document.createElement("canvas");
+                canvas.dataset.score = "true";
+                document.body.append(canvas);
+                return canvas;
+            });
+            await renderer.render(track);
+            return { calls, images };
+        }, code);
+    } finally {
+        await page.close();
+    }
+}
+
+async function captureTextCalls(browser, code) {
+    return (await captureRender(browser, code)).calls;
+}
+
+function callWithText(calls, text) {
+    const call = calls.find((entry) => entry.text === text);
+    assert.ok(call, `Expected renderer to draw ${JSON.stringify(text)}.`);
+    return call;
+}
+
+function assertSameBaseline(first, second) {
+    assert.equal(first.y, second.y, "Expected chord label to share its root's baseline.");
+}
+
+async function main() {
+    const browser = await puppeteer.launch(browserLaunchOptions());
+
+    try {
+        const defaultCalls = await captureTextCalls(browser, "| Am | CM |");
+        const defaultMinor = callWithText(defaultCalls, "–");
+        const defaultMajor = callWithText(defaultCalls, "Δ");
+        assert.equal(defaultMinor.maxWidth, compactLabelWidth);
+        assert.equal(defaultMajor.maxWidth, compactLabelWidth);
+
+        const explicitCompactCalls = await captureTextCalls(
+            browser,
+            "%PARAM={\"minor_label\":\"–\",\"major_label\":\"Δ\",\"chord_suffix_style\":\"compact\"}\n| Am | CM |"
+        );
+        assert.equal(callWithText(explicitCompactCalls, "–").maxWidth, compactLabelWidth);
+        assert.equal(callWithText(explicitCompactCalls, "Δ").maxWidth, compactLabelWidth);
+
+        const customCompactCalls = await captureTextCalls(
+            browser,
+            "%PARAM={\"minor_label\":\"m\",\"major_label\":\"M\"}\n| Am | CM |"
+        );
+        assert.equal(callWithText(customCompactCalls, "m").maxWidth, compactLabelWidth);
+        assert.equal(callWithText(customCompactCalls, "M").maxWidth, compactLabelWidth);
+
+        const inlineCalls = await captureTextCalls(
+            browser,
+            "%PARAM={\"minor_label\":\"m\",\"major_label\":\"M\",\"chord_suffix_style\":\"inline\"}\n| Am7 | BM7 | C-5 | D7#11 | E/F |"
+        );
+        const inlineMinor = callWithText(inlineCalls, "m");
+        const inlineMajor = callWithText(inlineCalls, "M");
+        const inlineSeventh = callWithText(inlineCalls, "7");
+        const inlineFifth = callWithText(inlineCalls, "-5");
+        const inlineAlteration = callWithText(inlineCalls, "11");
+        const inlineBass = callWithText(inlineCalls, "/F");
+        [inlineMinor, inlineMajor, inlineSeventh, inlineFifth, inlineAlteration, inlineBass]
+            .forEach((call) => assert.equal(call.maxWidth, null));
+        assertSameBaseline(callWithText(inlineCalls, "A"), inlineMinor);
+        [inlineMajor, inlineSeventh, inlineFifth, inlineAlteration, inlineBass]
+            .forEach((call) => assertSameBaseline(inlineMinor, call));
+
+        for (const style of ["compact", "inline"]) {
+            const defaults = await captureTextCalls(browser,
+                `%PARAM={"chord_suffix_style":"${style}"}\n| Cdim | Cm7-5 | Caug | C+ |`);
+            assert.deepEqual(defaults.map(call => call.text), ["C", "O", "C", "Ø", "C", "+", "C", "+"]);
+            for (const [chord, label] of [["Cdim", "dim"], ["Cm7-5", "m7-5"], ["Cm7b5", "m7-5"], ["Caug", "aug"], ["C+", "aug"]]) {
+                const calls = await captureTextCalls(browser,
+                    `%PARAM={"diminished_label":"dim","half_diminished_label":"m7-5","augmented_label":"aug","chord_suffix_style":"${style}"}\n| ${chord} |`);
+                assert.deepEqual(calls.map(call => call.text), ["C", label]);
+                assert.equal(calls[1].maxWidth, null, "A label must not be squeezed into a one-symbol width");
+                assert.equal(parseFloat(/([\d.]+)px/.exec(calls[1].font)[1]), baseFontSize * (style === "inline" ? 1 : 0.5));
+                if (style === "inline") assertSameBaseline(calls[0], calls[1]);
+            }
+            const extended = await captureTextCalls(browser,
+                `%KEY="C"\n%TRANSPOSE=2\n%PARAM={"half_diminished_label":"m7-5","chord_suffix_style":"${style}"}\n| Cm7-5add9/G:4 |`);
+            assert.deepEqual(extended.map(call => call.text), ["D", "m7-5", "add9", "/A"]);
+        }
+
+        for (const chord of ["C#dim7", "Dbm7-5", "F#aug", "C#/G"]) {
+            const { calls, images } = await captureRender(browser,
+                `%PARAM={"chord_suffix_style":"inline"}\n| ${chord} |`);
+            assert.ok(images[0], "The root accidental must be drawn");
+            assert.ok(calls[1].x >= images[0].x + images[0].width - 0.001,
+                `${chord}: an inline suffix must follow the complete root, including its accidental`);
+        }
+        for (const [chord, parameter, label] of [["Cm7", "minor_label", "min"], ["CM7", "major_label", "maj"]]) {
+            const calls = await captureTextCalls(browser, `%PARAM={"${parameter}":"${label}"}\n| ${chord} |`);
+            const quality = callWithText(calls, label);
+            assert.equal(quality.maxWidth, null, "All multi-character quality labels use their natural width");
+            assert.ok(callWithText(calls, "7").x >= quality.x + quality.naturalWidth - 0.001);
+        }
+    } finally {
+        await browser.close();
+    }
+}
+
+main().catch((error) => {
+    console.error(error);
+    process.exitCode = 1;
+});
