{
  "New Score": {
    "prefix": "fumen-new",
    "body": [
      "%TITLE=\"${1:Song title}\"",
      "%ARTIST=\"${2:Artist}\"",
      "",
      "[${3:A}]",
      "| ${4} | ${5} | ${6} | ${7} |",
      "$0"
    ],
    "description": "Title, artist and four bars. Use Tab to move between placeholders."
  },
  "4 bars": {
    "prefix": "fumen-4bars",
    "body": [
      "| ${1} | ${2} | ${3} | ${4} |",
      "$0"
    ],
    "description": "Four bars. Use Tab to move between bars."
  },
  "8 bars": {
    "prefix": "fumen-8bars",
    "body": [
      "| ${1} | ${2} | ${3} | ${4} |",
      "| ${5} | ${6} | ${7} | ${8} |",
      "$0"
    ],
    "description": "Two rows of four bars."
  },
  "Section": {
    "prefix": "fumen-section",
    "body": [
      "",
      "[${1:A}]",
      "| ${2} | ${3} | ${4} | ${5} |",
      "$0"
    ],
    "description": "Blank line, section label and four bars. Insert at the start of a line."
  },
  "Repeat": {
    "prefix": "fumen-repeat",
    "body": [
      "||: ${1} | ${2} | ${3} | ${4} :||",
      "$0"
    ],
    "description": "Four bars with repeat boundaries."
  },
  "First and second endings": {
    "prefix": "fumen-endings",
    "body": [
      "||: ${1} | ${2} | [1.] ${3} | ${4} :||",
      ">| [2.] ${5} | ${6} ||.",
      "$0"
    ],
    "description": "Repeat with first and second endings. Insert at the start of a line."
  },
  "Annotation above chord": {
    "prefix": "fumen-note",
    "body": "'${1:annotation}'@ ${0}",
    "description": "Annotation attached above the following chord."
  },
  "Lyrics": {
    "prefix": "fumen-lyric",
    "body": "`${1:lyrics}`@ ${0}",
    "description": "Lyrics attached below the following chord."
  }
}
